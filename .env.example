# Copy to .env — every value has a development default, so this file is optional.

PORT=3000
# sqlx SQLite URL; the file is created on first boot and migrated automatically.
DATABASE_URL=sqlite://cliuno.db

# JWT signing secrets (generate your own: openssl rand -base64 32)
JWT_SECRET_KEY=change-me-access-secret
REFRESH_JWT_SECRET_KEY=change-me-refresh-secret
# Token lifetimes in seconds (1 hour / 7 days)
ACCESS_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=604800

# bcrypt work factor (4-31)
BCRYPT_COST=10

# Absolute origin used in upload URLs; defaults to the request's Host.
# PUBLIC_BASE_URL=http://localhost:3000
UPLOAD_DIR=uploads

# Links in verification / reset emails point here.
FRONTEND_URL=http://localhost:5173

# Plain SMTP (no TLS) — mailpit/MailHog locally. Leave MAIL_HOST empty to log mails instead.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@cliuno.local

# Log filter (tracing EnvFilter syntax)
RUST_LOG=cliuno_axum_template=info,tower_http=info
